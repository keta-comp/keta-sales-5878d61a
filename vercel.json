{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": ".vercel/output",
  "build": {
    "env": {
      "NITRO_PRESET": "vercel"
    }
  },
  "crons": [
    {
      "path": "/api/public/telegram/daily-report",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/public/reminders",
      "schedule": "*/15 * * * *"
    }
  ]
}
